# AetherGate v2 — Beta 1 production profile sample configuration.
#
# Copy to deploy/beta1/.env, fill in real values, and `chmod 600 deploy/beta1/.env`.
# This file contains NO live secrets — only placeholder names. Generate real
# secrets with the commands in docs/operations/beta1-runbook.md.

# --- Database (required) ---------------------------------------------------
POSTGRES_PASSWORD=

# --- Queue encryption key (required; outside PostgreSQL) -------------------
# Generate: python3 -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
AETHERGATE_QUEUE_KEY=

# --- One-use admin bootstrap (required for first setup; remove after use) ---
# Generate: python3 -c 'import secrets; print("agb_" + secrets.token_urlsafe(32))'
AETHERGATE_BOOTSTRAP_TOKEN=

# --- Provider egress (required; literal IPv4/IPv6 only in prod) ------------
# Comma-separated literal IPs of approved upstream hosts. e.g. 192.168.22.50
AETHERGATE_UPSTREAM_ALLOWLIST=

# --- Provider secrets (file backend; directory of per-SecretRef.id files) --
# Absolute host path to the read-only secret directory projected into
# /run/secrets/aethergate-provider. Create one file per SecretRef id. May be
# empty if every configured provider is anonymous (e.g. a local Ollama).
AETHERGATE_SECRET_HOST_DIR=

# --- Stable loopback API port (optional) -----------------------------------
# Leave unset for an ephemeral Docker-assigned loopback port. Set a fixed value
# when a persistent host-level listener or Tailscale Serve front-end must keep a
# stable upstream target across container restart/recreation (e.g. 39549). The
# port stays bound to 127.0.0.1 only; never expose the container port directly.
AETHERGATE_API_HOST_PORT=

# --- OIDC human identity (optional; HTTPS issuer required in prod) ---------
AETHERGATE_OIDC_ENABLED=false
AETHERGATE_OIDC_ISSUER=
AETHERGATE_OIDC_CLIENT_ID=
AETHERGATE_OIDC_CLIENT_SECRET=
AETHERGATE_OIDC_REDIRECT_URI=
AETHERGATE_OIDC_WEB_CALLBACK_PATH=
AETHERGATE_OIDC_DEVICE_CLIENT_ID=
