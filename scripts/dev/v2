#!/usr/bin/env bash
#
# AetherGate v2 development helper (nomnom test bed).
#
# Usage: scripts/dev/v2 <command>
#
#   build     build the v2 container image
#   up        start postgres + api + worker (loopback-only, ephemeral host port)
#   url       print the AETHERGATE_BASE_URL / AETHERGATE_HEALTH_URL
#   wait      block until readiness passes
#   migrate   run the v2 migrations inside the api container
#   test      run the test suite inside the api container
#   workers   scale the scheduler worker service to N replicas (default 2)
#   inspect   print a scheduler queue-state summary (no content)
#   reconcile list | resolve <id> --disposition <state> --by <operator>
#   down      stop the stack (keeps the postgres volume)
#   reset     stop the stack and DELETE the postgres volume (destructive)
#   web       web console + dev OIDC IdP (web up | url | down)

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
COMPOSE_DIR="$REPO_ROOT/deploy/v2"
ENV_FILE="$COMPOSE_DIR/.env"

COMPOSE=(docker compose --project-directory "$COMPOSE_DIR" --file "$COMPOSE_DIR/compose.yaml")
WEB_COMPOSE=(docker compose --project-directory "$COMPOSE_DIR" --file "$COMPOSE_DIR/compose.yaml" --file "$COMPOSE_DIR/compose.web.yaml")

die() { printf 'error: %s\n' "$*" >&2; exit 1; }

# Primary non-loopback IPv4 address of the host, used as the deterministic dev
# IdP issuer so both the gateway container and the browser can reach it.
host_ip() {
    python3 - <<'PY'
import socket
s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
try:
    s.connect(("8.8.8.8", 80))
    print(s.getsockname()[0])
except OSError:
    print("127.0.0.1")
finally:
    s.close()
PY
}

# Write the OIDC web-console env into deploy/v2/.env if not already present.
# The IdP issuer is the host LAN IP (reachable from both the container and the
# browser); the web console is the fixed loopback port 8080.
ensure_oidc_web() {
    local issuer client_id redirect_uri
    issuer="http://$(host_ip):8090"
    client_id="${AETHERGATE_OIDC_CLIENT_ID:-aethergate-dev-client}"
    redirect_uri="http://127.0.0.1:8080/admin/v1/auth/oidc/callback"

    touch "$ENV_FILE"
    grep -q '^AETHERGATE_OIDC_ENABLED=' "$ENV_FILE" || {
        printf 'AETHERGATE_OIDC_ENABLED=true\n' >> "$ENV_FILE"
    }
    grep -q '^AETHERGATE_OIDC_ISSUER=' "$ENV_FILE" || {
        printf 'AETHERGATE_OIDC_ISSUER=%s\n' "$issuer" >> "$ENV_FILE"
    }
    grep -q '^AETHERGATE_OIDC_CLIENT_ID=' "$ENV_FILE" || {
        printf 'AETHERGATE_OIDC_CLIENT_ID=%s\n' "$client_id" >> "$ENV_FILE"
    }
    grep -q '^AETHERGATE_OIDC_REDIRECT_URI=' "$ENV_FILE" || {
        printf 'AETHERGATE_OIDC_REDIRECT_URI=%s\n' "$redirect_uri" >> "$ENV_FILE"
    }
    grep -q '^AETHERGATE_OIDC_JIT_PROVISIONING=' "$ENV_FILE" || {
        printf 'AETHERGATE_OIDC_JIT_PROVISIONING=false\n' >> "$ENV_FILE"
    }
    grep -q '^AETHERGATE_OIDC_SUBJECT=' "$ENV_FILE" || {
        printf 'AETHERGATE_OIDC_SUBJECT=dev-user\n' >> "$ENV_FILE"
    }
    printf 'OIDC issuer=%s redirect_uri=%s\n' "$issuer" "$redirect_uri" >&2
}

ensure_password() {
    if [[ -f "$ENV_FILE" ]] && grep -q '^POSTGRES_PASSWORD=' "$ENV_FILE"; then
        return 0
    fi
    local pw
    pw="$(python3 -c 'import secrets; print(secrets.token_urlsafe(24))')"
    {
        printf '# Generated by scripts/dev/v2 — do not commit\n'
        printf 'POSTGRES_PASSWORD=%s\n' "$pw"
    } >> "$ENV_FILE"
    printf 'wrote POSTGRES_PASSWORD to %s\n' "$ENV_FILE" >&2
}

ensure_queue_key() {
    if [[ -f "$ENV_FILE" ]] && grep -q '^AETHERGATE_QUEUE_KEY=' "$ENV_FILE"; then
        return 0
    fi
    local key
    key="$(python3 -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())')"
    {
        printf '# Generated by scripts/dev/v2 — do not commit\n'
        printf 'AETHERGATE_QUEUE_KEY=%s\n' "$key"
    } >> "$ENV_FILE"
    printf 'wrote AETHERGATE_QUEUE_KEY to %s\n' "$ENV_FILE" >&2
}

ensure_bootstrap_token() {
    if [[ -f "$ENV_FILE" ]] && grep -q '^AETHERGATE_BOOTSTRAP_TOKEN=' "$ENV_FILE"; then
        return 0
    fi
    local bt
    bt="$(python3 -c 'import secrets; print("agb_" + secrets.token_urlsafe(32))')"
    {
        printf '# Generated by scripts/dev/v2 — do not commit\n'
        printf 'AETHERGATE_BOOTSTRAP_TOKEN=%s\n' "$bt"
    } >> "$ENV_FILE"
    printf 'wrote AETHERGATE_BOOTSTRAP_TOKEN to %s\n' "$ENV_FILE" >&2
}

api_host_port() {
    "${COMPOSE[@]}" port api 8000
}

base_url() {
    local port
    port="$(api_host_port | sed 's/.*://')"
    printf 'http://127.0.0.1:%s/v1\n' "$port"
}

health_url() {
    local port
    port="$(api_host_port | sed 's/.*://')"
    printf 'http://127.0.0.1:%s/health/ready\n' "$port"
}

cmd_build() {
    ensure_password
    ensure_queue_key
    ensure_bootstrap_token
    "${COMPOSE[@]}" build
}

cmd_up() {
    ensure_password
    ensure_queue_key
    ensure_bootstrap_token
    "${COMPOSE[@]}" up -d
    cmd_url
}

cmd_url() {
    printf 'AETHERGATE_BASE_URL=%s\n' "$(base_url)"
    printf 'AETHERGATE_HEALTH_URL=%s\n' "$(health_url)"
}

cmd_wait() {
    local url="$1"
    local attempts="${2:-60}"
    local delay="${3:-2}"
    local i
    for ((i = 1; i <= attempts; i++)); do
        if curl -fsS "$url" > /dev/null 2>&1; then
            printf 'ready: %s\n' "$url"
            return 0
        fi
        sleep "$delay"
    done
    die "readiness did not pass within $((attempts * delay))s: $url"
}

cmd_migrate() {
    "${COMPOSE[@]}" run --rm --no-deps api \
        alembic -c src/aethergate/migrations/alembic.ini upgrade head
}

password() {
    grep '^POSTGRES_PASSWORD=' "$ENV_FILE" | head -1 | cut -d= -f2-
}

cmd_test() {
    local test_url
    test_url="postgresql+asyncpg://aethergate:$(password)@postgres:5432/aethergate_test"
    "${COMPOSE[@]}" run --rm --no-deps -e "AETHERGATE_TEST_DATABASE_URL=${test_url}" api \
        python -m pytest -q
}

cmd_down() {
    "${COMPOSE[@]}" down
}

cmd_workers() {
    local replicas="${1:-2}"
    ensure_password
    ensure_queue_key
    ensure_bootstrap_token
    "${COMPOSE[@]}" up -d --scale "worker=${replicas}"
    printf 'worker replicas set to %s\n' "$replicas"
}

cmd_inspect() {
    ensure_password
    local db_host
    db_host="$(docker inspect --format '{{range .NetworkSettings.Networks}}{{.IPAddress}}{{end}}' aethergate-v2-postgres 2>/dev/null || true)"
    if [[ -z "$db_host" ]]; then
        die "postgres container not running (try: scripts/dev/v2 up)"
    fi
    "${COMPOSE[@]}" run --rm --no-deps -e AETHERGATE_INSPECT_DB_HOST="$db_host" api \
        python -m aethergate.inspect_queue
}

cmd_reconcile() {
    ensure_password
    local db_host
    db_host="$(docker inspect --format '{{range .NetworkSettings.Networks}}{{.IPAddress}}{{end}}' aethergate-v2-postgres 2>/dev/null || true)"
    if [[ -z "$db_host" ]]; then
        die "postgres container not running (try: scripts/dev/v2 up)"
    fi
    shift || true
    "${COMPOSE[@]}" run --rm --no-deps -e AETHERGATE_INSPECT_DB_HOST="$db_host" api \
        python -m aethergate.reconcile "$@"
}

cmd_reset() {
    "${COMPOSE[@]}" down --volumes
}

cmd_web_up() {
    ensure_password
    ensure_queue_key
    ensure_bootstrap_token
    ensure_oidc_web
    "${WEB_COMPOSE[@]}" up -d
    cmd_web_url
}

cmd_web_url() {
    printf 'AETHERGATE_WEB_URL=http://127.0.0.1:8080\n'
    printf 'AETHERGATE_OIDC_ISSUER=http://%s:8090\n' "$(host_ip)"
}

cmd_web_down() {
    "${WEB_COMPOSE[@]}" down
}

usage() {
    sed -n '2,16p' "${BASH_SOURCE[0]}"
}

case "${1:-}" in
    build) cmd_build ;;
    up) cmd_up ;;
    url) cmd_url ;;
    wait) cmd_wait "${2:-$(health_url)}" ;;
    migrate) cmd_migrate ;;
    test) cmd_test ;;
    workers) cmd_workers "${2:-2}" ;;
    inspect) cmd_inspect ;;
    reconcile) cmd_reconcile "$@" ;;
    down) cmd_down ;;
    reset) cmd_reset ;;
    web) shift; case "${1:-}" in
        up) cmd_web_up ;;
        url) cmd_web_url ;;
        down) cmd_web_down ;;
        *) die "web subcommand: up | url | down" ;;
    esac ;;
    help|-h|--help) usage ;;
    *) usage; die "unknown command: ${1:-<none>}" ;;
esac
