#!/usr/bin/env bash
#
# AetherGate v2 development helper (nomnom test bed).
#
# Usage: scripts/dev/v2 <command>
#
#   build     build the v2 container image
#   up        start postgres + api (loopback-only, ephemeral host port)
#   url       print the AETHERGATE_BASE_URL / AETHERGATE_HEALTH_URL
#   wait      block until readiness passes
#   migrate   run the v2 migrations inside the api container
#   test      run the test suite inside the api container
#   down      stop the stack (keeps the postgres volume)
#   reset     stop the stack and DELETE the postgres volume (destructive)

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
COMPOSE_DIR="$REPO_ROOT/deploy/v2"
ENV_FILE="$COMPOSE_DIR/.env"

COMPOSE=(docker compose --project-directory "$COMPOSE_DIR" --file "$COMPOSE_DIR/compose.yaml")

die() { printf 'error: %s\n' "$*" >&2; exit 1; }

ensure_password() {
    if [[ -f "$ENV_FILE" ]] && grep -q '^POSTGRES_PASSWORD=' "$ENV_FILE"; then
        return 0
    fi
    local pw
    pw="$(python3 -c 'import secrets; print(secrets.token_urlsafe(24))')"
    {
        printf '# Generated by scripts/dev/v2 — do not commit\n'
        printf 'POSTGRES_PASSWORD=%s\n' "$pw"
    } >> "$ENV_FILE"
    printf 'wrote POSTGRES_PASSWORD to %s\n' "$ENV_FILE" >&2
}

api_host_port() {
    "${COMPOSE[@]}" port api 8000
}

base_url() {
    local port
    port="$(api_host_port | sed 's/.*://')"
    printf 'http://127.0.0.1:%s/v1\n' "$port"
}

health_url() {
    local port
    port="$(api_host_port | sed 's/.*://')"
    printf 'http://127.0.0.1:%s/health/ready\n' "$port"
}

cmd_build() {
    ensure_password
    "${COMPOSE[@]}" build
}

cmd_up() {
    ensure_password
    "${COMPOSE[@]}" up -d
    cmd_url
}

cmd_url() {
    printf 'AETHERGATE_BASE_URL=%s\n' "$(base_url)"
    printf 'AETHERGATE_HEALTH_URL=%s\n' "$(health_url)"
}

cmd_wait() {
    local url="$1"
    local attempts="${2:-60}"
    local delay="${3:-2}"
    local i
    for ((i = 1; i <= attempts; i++)); do
        if curl -fsS "$url" > /dev/null 2>&1; then
            printf 'ready: %s\n' "$url"
            return 0
        fi
        sleep "$delay"
    done
    die "readiness did not pass within $((attempts * delay))s: $url"
}

cmd_migrate() {
    "${COMPOSE[@]}" run --rm --no-deps api \
        alembic -c src/aethergate/migrations/alembic.ini upgrade head
}

password() {
    grep '^POSTGRES_PASSWORD=' "$ENV_FILE" | head -1 | cut -d= -f2-
}

cmd_test() {
    local test_url
    test_url="postgresql+asyncpg://aethergate:$(password)@postgres:5432/aethergate_test"
    "${COMPOSE[@]}" run --rm --no-deps -e "AETHERGATE_TEST_DATABASE_URL=${test_url}" api \
        python -m pytest -q
}

cmd_down() {
    "${COMPOSE[@]}" down
}

cmd_reset() {
    "${COMPOSE[@]}" down --volumes
}

usage() {
    sed -n '2,14p' "${BASH_SOURCE[0]}"
}

case "${1:-}" in
    build) cmd_build ;;
    up) cmd_up ;;
    url) cmd_url ;;
    wait) cmd_wait "${2:-$(health_url)}" ;;
    migrate) cmd_migrate ;;
    test) cmd_test ;;
    down) cmd_down ;;
    reset) cmd_reset ;;
    help|-h|--help) usage ;;
    *) usage; die "unknown command: ${1:-<none>}" ;;
esac
